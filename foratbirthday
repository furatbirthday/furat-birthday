<!DOCTYPE html>

<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>عيد ميلاد سعيد يا فرات ❤️</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    min-height: 100vh;
    overflow-x: hidden;
    font-family: Tahoma, Arial, sans-serif;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 25px 15px;
    background: linear-gradient(-45deg, #ff758c, #ff7eb3, #ffb199, #ffd194);
    background-size: 400% 400%;
    animation: bgMove 10s ease infinite;
    position: relative;
}

@keyframes bgMove {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
}

/* دوائر ضوء متحركة */
.glow {
    position: fixed;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.18);
    filter: blur(2px);
    pointer-events: none;
    z-index: 0;
    animation: glowMove 7s ease-in-out infinite alternate;
}

.glow.one {
    width: 180px;
    height: 180px;
    top: 8%;
    right: 7%;
}

.glow.two {
    width: 130px;
    height: 130px;
    bottom: 13%;
    left: 8%;
    animation-delay: 1.3s;
}

.glow.three {
    width: 95px;
    height: 95px;
    top: 65%;
    right: 15%;
    animation-delay: 2.5s;
}

@keyframes glowMove {
    from {
        transform: translateY(0) scale(1);
        opacity: 0.4;
    }
    to {
        transform: translateY(-35px) scale(1.2);
        opacity: 0.75;
    }
}

/* بالونات متحركة */
.balloon {
    position: fixed;
    width: 58px;
    height: 72px;
    border-radius: 50% 50% 46% 46%;
    opacity: 0.85;
    z-index: 2;
    pointer-events: none;
    animation: balloonFloat 6s ease-in-out infinite;
}

.balloon::before {
    content: "";
    position: absolute;
    width: 12px;
    height: 10px;
    background: inherit;
    left: 23px;
    top: 66px;
    transform: rotate(45deg);
}

.balloon::after {
    content: "";
    position: absolute;
    width: 2px;
    height: 85px;
    background: rgba(255, 255, 255, 0.65);
    left: 50%;
    top: 72px;
}

.balloon.b1 {
    background: #ffffff;
    top: 16%;
    left: 7%;
}

.balloon.b2 {
    background: #ff4d88;
    top: 22%;
    right: 7%;
    animation-delay: 1.4s;
}

.balloon.b3 {
    background: #ffd1dc;
    bottom: 18%;
    left: 10%;
    animation-delay: 2.3s;
}

@keyframes balloonFloat {
    0%, 100% {
        transform: translateY(0) rotate(-5deg);
    }
    50% {
        transform: translateY(-35px) rotate(6deg);
    }
}

/* رسومات صغيرة عائمة */
.floating-drawing {
    position: fixed;
    font-size: 34px;
    z-index: 3;
    pointer-events: none;
    opacity: 0.85;
    animation: drawingFloat 5.5s ease-in-out infinite;
}

.floating-drawing.d1 {
    top: 12%;
    left: 18%;
}

.floating-drawing.d2 {
    top: 12%;
    right: 18%;
    animation-delay: 1.2s;
}

.floating-drawing.d3 {
    bottom: 13%;
    right: 12%;
    animation-delay: 2s;
}

.floating-drawing.d4 {
    bottom: 12%;
    left: 18%;
    animation-delay: 2.7s;
}

@keyframes drawingFloat {
    0%, 100% {
        transform: translateY(0) rotate(-8deg) scale(1);
    }
    50% {
        transform: translateY(-24px) rotate(8deg) scale(1.12);
    }
}

.card {
    width: 95%;
    max-width: 760px;
    background: rgba(255, 255, 255, 0.22);
    backdrop-filter: blur(13px);
    padding: 38px 28px;
    border-radius: 30px;
    text-align: center;
    color: white;
    z-index: 10;
    box-shadow: 0 15px 45px rgba(0, 0, 0, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.35);
    position: relative;
}

h1 {
    font-size: 2.8rem;
    margin-bottom: 20px;
    text-shadow: 0 3px 10px rgba(0,0,0,0.22);
    animation: titlePulse 2.2s ease-in-out infinite;
}

@keyframes titlePulse {
    0%, 100% {
        transform: scale(1);
    }
    50% {
        transform: scale(1.035);
    }
}

/* كيكة متحركة */
.cake {
    width: 190px;
    height: 140px;
    margin: 0 auto 15px;
    position: relative;
    animation: cakeFloat 2.6s ease-in-out infinite;
}

.cake-plate {
    width: 195px;
    height: 18px;
    background: rgba(255, 255, 255, 0.88);
    border-radius: 50%;
    position: absolute;
    bottom: 0;
    left: -2px;
}

.cake-layer-bottom {
    width: 160px;
    height: 55px;
    background: #ff4d88;
    border-radius: 14px 14px 18px 18px;
    position: absolute;
    bottom: 15px;
    left: 15px;
    box-shadow: 0 8px 20px rgba(0,0,0,0.18);
}

.cake-layer-top {
    width: 125px;
    height: 45px;
    background: #ffffff;
    border-radius: 14px 14px 12px 12px;
    position: absolute;
    bottom: 68px;
    left: 32px;
}

.cake-drip {
    width: 18px;
    height: 28px;
    background: #ffffff;
    border-radius: 0 0 12px 12px;
    position: absolute;
    bottom: 47px;
}

.cake-drip.drp1 { left: 42px; }
.cake-drip.drp2 { left: 85px; height: 22px; }
.cake-drip.drp3 { left: 127px; height: 30px; }

.candle {
    width: 10px;
    height: 34px;
    background: #ffd194;
    border-radius: 6px;
    position: absolute;
    bottom: 111px;
}

.candle.c1 { left: 67px; }
.candle.c2 { left: 91px; }
.candle.c3 { left: 115px; }

.flame {
    width: 14px;
    height: 20px;
    background: #fff176;
    border-radius: 50% 50% 50% 50%;
    position: absolute;
    bottom: 142px;
    box-shadow: 0 0 18px rgba(255, 241, 118, 0.95);
    animation: flameFlicker 0.45s infinite alternate;
}

.flame.f1 { left: 65px; }
.flame.f2 { left: 89px; animation-delay: 0.1s; }
.flame.f3 { left: 113px; animation-delay: 0.2s; }

@keyframes cakeFloat {
    0%, 100% {
        transform: translateY(0);
    }
    50% {
        transform: translateY(-8px);
    }
}

@keyframes flameFlicker {
    from {
        transform: scale(1) rotate(-5deg);
        opacity: 0.85;
    }
    to {
        transform: scale(1.25) rotate(6deg);
        opacity: 1;
    }
}

.surprise-btn {
    margin-top: 30px;
    padding: 15px 35px;
    border: none;
    border-radius: 16px;
    background: white;
    color: #ff4d88;
    font-size: 19px;
    font-weight: bold;
    cursor: pointer;
    transition: 0.3s;
    box-shadow: 0 8px 20px rgba(0,0,0,0.18);
}

.surprise-btn:hover {
    transform: scale(1.07);
}

.surprise-btn:disabled {
    cursor: default;
}

/* منطقة الهدية */
.gift-box-area {
    display: none;
    margin-top: 35px;
    position: relative;
    animation: fadeIn 0.8s ease;
}

.gift-box {
    width: 150px;
    height: 130px;
    margin: 0 auto 20px;
    position: relative;
    animation: bounceGift 1.1s infinite alternate;
}

.gift-body {
    width: 150px;
    height: 95px;
    background: #ff4d88;
    border-radius: 14px;
    position: absolute;
    bottom: 0;
    box-shadow: 0 10px 25px rgba(0,0,0,0.25);
}

.gift-lid {
    width: 170px;
    height: 38px;
    background: #ffffff;
    border-radius: 12px;
    position: absolute;
    top: 0;
    left: -10px;
    z-index: 3;
    animation: openLid 1.2s ease forwards;
    transform-origin: left bottom;
}

.gift-ribbon-vertical {
    width: 30px;
    height: 130px;
    background: #fff;
    position: absolute;
    left: 60px;
    bottom: 0;
    z-index: 4;
    border-radius: 8px;
}

.gift-ribbon-horizontal {
    width: 150px;
    height: 25px;
    background: #fff;
    position: absolute;
    left: 0;
    bottom: 38px;
    z-index: 4;
}

.gift-letter {
    display: none;
    background: rgba(255,255,255,0.31);
    padding: 28px 23px;
    border-radius: 24px;
    margin-top: 25px;
    animation: letterUp 1.2s ease forwards;
    box-shadow: 0 12px 32px rgba(0,0,0,0.20);
    border: 1px solid rgba(255,255,255,0.45);
}

.gift-letter h2 {
    margin-bottom: 17px;
    font-size: 1.75rem;
}

.gift-letter p {
    font-size: 1.18rem;
    line-height: 2.1;
}

.final-line {
    margin-top: 15px;
    font-size: 1.35rem;
    font-weight: bold;
}

/* قلوب ونجوم بالخلفية */
.heart {
    position: fixed;
    color: white;
    font-size: 24px;
    animation: floatHeart linear infinite;
    opacity: 0.9;
    pointer-events: none;
    z-index: 1;
}

.sparkle {
    position: fixed;
    color: #fff;
    font-size: 18px;
    animation: sparkleMove linear infinite;
    pointer-events: none;
    z-index: 1;
}

.confetti {
    position: fixed;
    font-size: 25px;
    animation: popConfetti 1.8s ease forwards;
    pointer-events: none;
    z-index: 999;
}

/* Animations */
@keyframes fadeIn {
    from { 
        opacity: 0; 
        transform: translateY(15px); 
    }
    to { 
        opacity: 1; 
        transform: translateY(0); 
    }
}

@keyframes bounceGift {
    from {
        transform: translateY(0);
    }
    to {
        transform: translateY(-10px);
    }
}

@keyframes openLid {
    0% {
        transform: rotate(0deg) translateY(0);
    }
    100% {
        transform: rotate(-30deg) translateY(-38px);
    }
}

@keyframes letterUp {
    from {
        opacity: 0;
        transform: translateY(35px) scale(0.95);
    }
    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

@keyframes floatHeart {
    from {
        transform: translateY(100vh) rotate(0deg);
        opacity: 1;
    }
    to {
        transform: translateY(-120px) rotate(360deg);
        opacity: 0;
    }
}

@keyframes sparkleMove {
    from {
        transform: translateY(100vh);
        opacity: 1;
    }
    to {
        transform: translateY(-100px);
        opacity: 0;
    }
}

@keyframes popConfetti {
    0% {
        opacity: 1;
        transform: translate(0, 0) scale(0.5);
    }
    100% {
        opacity: 0;
        transform: translate(var(--x), var(--y)) scale(1.4) rotate(360deg);
    }
}

/* للموبايل */
@media (max-width: 600px) {
    body {
        align-items: flex-start;
    }

    .balloon {
        width: 42px;
        height: 56px;
    }

    .balloon::after {
        height: 55px;
        top: 55px;
    }

    .floating-drawing {
        font-size: 26px;
    }

    .floating-drawing.d1 {
        top: 7%;
        left: 6%;
    }

    .floating-drawing.d2 {
        top: 8%;
        right: 7%;
    }

    .floating-drawing.d3 {
        bottom: 6%;
        right: 5%;
    }

    .floating-drawing.d4 {
        bottom: 6%;
        left: 5%;
    }

    .card {
        padding: 30px 20px;
        margin-top: 15px;
    }

    h1 {
        font-size: 2rem;
    }

    .cake {
        transform: scale(0.88);
        margin-bottom: 5px;
    }

    .surprise-btn {
        font-size: 16px;
        padding: 13px 25px;
    }

    .gift-letter h2 {
        font-size: 1.45rem;
    }

    .gift-letter p {
        font-size: 1.02rem;
        line-height: 2;
    }
}
</style>

</head>

