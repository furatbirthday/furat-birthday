</div>

<script>
function openGift() {
    const gift = document.getElementById("gift");
    const letter = document.querySelector(".gift-letter");
    const button = document.querySelector(".surprise-btn");

    gift.style.display = "block";
    button.innerHTML = "❤️ الهدية انفتحت";
    button.disabled = true;
    button.style.opacity = "0.85";

    setTimeout(() => {
        letter.style.display = "block";
    }, 950);

    for (let i = 0; i < 70; i++) {
        setTimeout(createConfetti, i * 35);
    }
}

function createHeart() {
    const heart = document.createElement("div");
    heart.classList.add("heart");
    heart.innerHTML = "❤";

    heart.style.left = Math.random() * 100 + "vw";
    heart.style.animationDuration = (Math.random() * 4 + 4) + "s";
    heart.style.fontSize = (Math.random() * 18 + 18) + "px";

    document.body.appendChild(heart);

    setTimeout(() => {
        heart.remove();
    }, 8000);
}

function createSparkle() {
    const sparkle = document.createElement("div");
    sparkle.classList.add("sparkle");
    sparkle.innerHTML = "✨";

    sparkle.style.left = Math.random() * 100 + "vw";
    sparkle.style.animationDuration = (Math.random() * 5 + 5) + "s";
    sparkle.style.fontSize = (Math.random() * 12 + 14) + "px";

    document.body.appendChild(sparkle);

    setTimeout(() => {
        sparkle.remove();
    }, 9000);
}

function createConfetti() {
    const symbols = ["❤️", "✨", "🌷", "🎉", "💖", "🎂", "🎈", "🎁", "🌟"];
    const confetti = document.createElement("div");

    confetti.classList.add("confetti");
    confetti.innerHTML = symbols[Math.floor(Math.random() * symbols.length)];

    confetti.style.left = "50%";
    confetti.style.top = "50%";
    confetti.style.setProperty("--x", (Math.random() * 600 - 300) + "px");
    confetti.style.setProperty("--y", (Math.random() * -410 - 80) + "px");

    document.body.appendChild(confetti);

    setTimeout(() => {
        confetti.remove();
    }, 1800);
}

setInterval(createHeart, 350);
setInterval(createSparkle, 800);
</script>

</body>
</html>
